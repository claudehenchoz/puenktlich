
// ---- {{ v.id }} -------------------------------------------------------------
{%- for car in cars %}
{%- if cars | length > 1 %}
// car {{ car.index }} ({{ car.key }}), length {{ car.length }}
{%- endif %}
{%- for var in car.sets %}
{%- for kind in car.kinds %}
spriteset(ss_{{ var.name }}_{{ kind }}, "{{ var.sheets[kind][1]['8bpp'] }}") {
{%- for r in car.rects[kind][1] %}
    {{ r.nml() }}
{%- endfor %}
}
{%- for scale, zoom in zooms %}
alternative_sprites(ss_{{ var.name }}_{{ kind }}, {{ zoom }}, BIT_DEPTH_32BPP, "{{ var.sheets[kind][scale]['32bpp'] }}", "{{ var.sheets[kind][scale]['mask'] }}") {
{%- for r in car.rects[kind][scale] %}
    {{ r.nml() }}
{%- endfor %}
}
{%- endfor %}
{%- endfor %}
{%- if articulated %}

switch (FEAT_TRAINS, SELF, sw_{{ var.name }}_shape, {{ car.shape_proc }}()) {
    PK_TURN_1: ss_{{ var.name }}_turn_1;
    PK_TURN_2: ss_{{ var.name }}_turn_2;
    PK_UP: ss_{{ var.name }}_up;
    PK_DOWN: ss_{{ var.name }}_down;
    ss_{{ var.name }}_normal;
}
{%- endif %}
{%- endfor %}
{%- if articulated %}
{%- set lm = car.light_map %}
{%- if not car.single_body %}

// light variant -> body. 2 = leads the train, 1 = last, 3 = both (running alone), 0 = middle
switch (FEAT_TRAINS, SELF, sw_{{ car.key }}_lights_body, {{ lights_expr }}) {
    2: sw_{{ lm.head[0] }}_shape;
    1: sw_{{ lm.tail[0] }}_shape;
    0: sw_{{ lm.none[0] }}_shape;
    sw_{{ lm.solo[0] }}_shape;
}
{%- endif %}
{%- if car.has_overlays %}

// light variant -> lamp overlay (second sprite layer)
switch (FEAT_TRAINS, SELF, sw_{{ car.key }}_lights_overlay, {{ lights_expr }}) {
{%- for code, var in [(2, "head"), (1, "tail"), (0, "none")] %}
    {{ code }}: {{ "sw_" ~ lm[var][1] ~ "_shape" if lm[var][1] else "ss_invisible" }};
{%- endfor %}
    {{ "sw_" ~ lm.solo[1] ~ "_shape" if lm.solo[1] else "ss_invisible" }};
}

// sprite stack on the middle part: layer 0 = body, layer 1 = lamps
switch (FEAT_TRAINS, SELF, sw_{{ car.key }}_mid, [
        STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
        getbits(extra_callback_info1, 8, 8)]) {
    0: {{ "sw_" ~ car.default_body ~ "_shape" if car.single_body else "sw_" ~ car.key ~ "_lights_body" }};
    1: sw_{{ car.key }}_lights_overlay;
    ss_invisible;
}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- if cargo_looks %}
{%- set car = cars[0] %}

// cargo stage of this part's own load: 0 empty, 1 partly loaded, 2 full
switch (FEAT_TRAINS, SELF, sw_{{ car.key }}_load,
        (cargo_count > 0) + (cargo_count * 2 > cargo_capacity)) {
    1: sw_{{ car.cargo_stages[1] }}_shape;
    2: sw_{{ car.cargo_stages[2] }}_shape;
    ss_invisible;
}
{%- for cl in cargo_looks %}

// cargo look "{{ cl.look }}": layer 0 = empty wagon, layer 1 = cargo{{ " recoloured " ~ cl.colour if cl.colour else "" }}
switch (FEAT_TRAINS, SELF, sw_{{ car.key }}_{{ cl.look }}_mid, [
        STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0)
                   | (getbits(extra_callback_info1, 8, 8) == 1 ? {{ "palette_1cc(COLOUR_" ~ cl.colour ~ ")" if cl.colour else "PALETTE_USE_DEFAULT" }} : PALETTE_USE_DEFAULT), 0x100),
        getbits(extra_callback_info1, 8, 8)]) {
    0: sw_{{ car.default_body }}_shape;
    1: sw_{{ car.key }}_load;
    ss_invisible;
}

switch (FEAT_TRAINS, SELF, sw_{{ v.id }}_parts_{{ cl.look }}, position_in_articulated_veh) {
    {{ car.mid_pos }}: sw_{{ car.key }}_{{ cl.look }}_mid;
    ss_invisible;
}
{%- endfor %}
{%- endif %}
{%- if articulated %}
{%- if not cargo_looks %}

// articulated parts: per car an invisible front, a sprite-carrying middle and an invisible rear
switch (FEAT_TRAINS, SELF, sw_{{ v.id }}_parts, position_in_articulated_veh) {
{%- for car in cars %}
    {{ car.mid_pos }}: {{ car.entry }};
{%- endfor %}
    ss_invisible;
}
{%- endif %}
{%- if parts | unique | list | length > 1 %}

switch (FEAT_TRAINS, SELF, sw_{{ v.id }}_length, position_in_articulated_veh) {
{%- for n in parts[:-1] %}
    {{ loop.index0 }}: return {{ n }};
{%- endfor %}
    return {{ parts[-1] }};
}
{%- endif %}
{%- endif %}
{% for l in liveries %}
{%- if articulated %}
switch (FEAT_TRAINS, SELF, sw_{{ l.ident }}_articulated, extra_callback_info1) {
    1..{{ parts | length - 1 }}: return {{ l.ident }};
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
{%- endif %}

item(FEAT_TRAINS, {{ l.ident }}, {{ l.item_id }}) {
    property {
        name: string({{ l.name_string }});
        climates_available: ALL_CLIMATES;
        introduction_date: date({{ v.intro_year }}, 1, 1);
        model_life: {{ v.model_life_years }};
        vehicle_life: {{ v.vehicle_life_years }};
        reliability_decay: {{ v.reliability_decay }};
        {%- if cargo %}
        refittable_cargo_classes: bitmask({{ cargo.classes }});
        non_refittable_cargo_classes: bitmask();
        default_cargo_type: {{ cargo.label }};
        cargo_capacity: {{ cargo.per_part }};  // per articulated part: {{ cargo.total }} in total
        {%- else %}
        refittable_cargo_classes: bitmask();
        non_refittable_cargo_classes: bitmask();
        cargo_capacity: 0;
        {%- endif %}
        cost_factor: {{ v.cost_factor }};
        running_cost_factor: {{ v.running_cost_factor }};
        running_cost_base: {{ running_cost_base }};
        sprite_id: SPRITE_ID_NEW_TRAIN;
        speed: {{ v.max_speed_kmh }} km/h;
        weight: {{ v.weight_t }} ton;
        track_type: {{ track_label }};
        length: {{ parts[0] if articulated else v.ottd_length }};
        misc_flags: bitmask(TRAIN_FLAG_2CC{{ ", TRAIN_FLAG_SPRITE_STACK" if has_stack else "" }});
        {%- if v.power_kw > 0 %}
        power: {{ v.power_kw }} kW;
        {%- if te_coefficient %}
        tractive_effort_coefficient: {{ te_coefficient }};
        {%- endif %}
        engine_class: {{ engine_class }};
        dual_headed: 0;
        {%- if v.kind == "control_car" %}
        // control car: no exhaust/sparks, last choice for AIs
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
        ai_engine_rank: 0;
        {%- else %}
        visual_effect_and_powered: visual_effect_and_powered({{ visual_effect }}, 2, DISABLE_WAGON_POWER);
        ai_special_flag: AI_FLAG_PASSENGER;
        {%- endif %}
        {%- else %}
        power: 0 kW;
        {%- endif %}
        badges: [{{ badges | map("tojson") | join(", ") }}];
        {%- if l.variant_group %}
        variant_group: {{ l.variant_group }};
        {%- endif %}
    }
    graphics {
        {%- if articulated %}
        {%- if cargo_looks %}
        default: sw_{{ v.id }}_parts_{{ default_look }};
        {%- for label, look in cargo_label_map.items() %}
        {{ label }}: sw_{{ v.id }}_parts_{{ look }};
        {%- endfor %}
        {%- else %}
        default: sw_{{ v.id }}_parts;
        {%- endif %}
        purchase: ss_{{ cars[0].default_body }}_normal;
        articulated_part: sw_{{ l.ident }}_articulated;
        {%- if parts | unique | list | length > 1 %}
        length: sw_{{ v.id }}_length;
        {%- endif %}
        {%- else %}
        default: ss_{{ cars[0].default_body }}_normal;
        {%- endif %}
        {%- if not l.livery.company_colours %}
        colour_mapping: return palette_2cc(COLOUR_{{ l.livery.cc1 }}, COLOUR_{{ l.livery.cc2 }});
        {%- endif %}
        {%- if v.description.get("en") %}
        additional_text: string({{ desc_string }});
        {%- endif %}
    }
}
{% endfor %}
