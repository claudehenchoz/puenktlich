// Generated by `pk build` — do not edit. Source of truth: data/*.yaml
grf {
    grfid: "{{ grfid }}";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESC);
    url: string(STR_GRF_URL);
    version: {{ version }};
    min_compatible_version: {{ min_compatible_version }};
}

{%- if cargos %}
cargotable {
    {{ cargos | join(", ") }}
}

{% endif -%}
{%- if railtypes %}
railtypetable {
{%- for rt in railtypes %}
    {{ rt.label }}: [{{ ([rt.label] + rt.fallbacks) | map("tojson") | join(", ") }}],
{%- endfor %}
}

{% endif -%}
badgetable {
{%- for b in badges %}
    {{ b.label | tojson }},
{%- endfor %}
}
{% for b in badges %}
item(FEAT_BADGES, badge_{{ b.ident }}) {
    property {
        label: {{ b.label | tojson }};
        name: string({{ b.string }});
        flags: 0;
    }
}
{% endfor %}
